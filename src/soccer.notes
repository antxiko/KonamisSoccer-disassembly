F 0x76a9 1
D 0x78f6 0x79fd patrones_de_sprite_78f6  263 bytes comprimidos que dan 576 de VRAM en 0x1DC0; lo carga 0x76DC
F 0x78f6 1
D 0x79fd 0x7af1 patrones_de_sprite_79fd  244 bytes comprimidos que dan 384 de VRAM en 0x18E0; lo carga 0x76E2
F 0x79fd 1
D 0x7b02 0x7c86 patrones_de_sprite_7b02  388 bytes comprimidos que dan 768 de VRAM en 0x1800; lo carga 0x7AF4
F 0x7b02 1
D 0x7c8c 0x7d14 patrones_de_sprite_7c8c  136 bytes comprimidos que dan 288 de VRAM en 0x1800; lo carga 0x7C89
