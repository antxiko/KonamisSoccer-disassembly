L 0x67c4 estirada_al_otro_lado
C 0x67c4 el dibujo 3
C 0x67cb misma cuenta, mismo umbral
L 0x67cc pasa_al_paso_del_portero
C 0x67cf (0xE315) sube
L 0x67d1 avanza_la_estirada la misma tabla que 0x6785, pero sin reflejar
C 0x67d1 el dibujo
C 0x67d6 la misma cuenta
C 0x67db la MISMA tabla que la del otro lado
C 0x67e1 y aqui el vector se usa tal cual: esa es la unica diferencia entre las dos rutinas
C 0x67e9 a lo ancho
C 0x67f0 y a lo alto
